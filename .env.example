# Copy to .env and fill in what you need. Everything is optional.

# --- In-room agents answer with these providers (otherwise they use free local replies) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Model overrides (optional) ---
# CLAUDE_MODEL=
# CLAUDE_ECO_MODEL=
# OPENAI_MODEL=
# OPENAI_ECO_MODEL=
# GEMINI_MODEL=
# GEMINI_ECO_MODEL=

# --- Goal runner (Build button, uses the local Claude Code CLI) ---
# CLAUDE_RUN_MODEL=sonnet      # use "haiku" for cheaper runs
# CLAUDE_RUN_MAX_TURNS=30

# --- Misc ---
# PORT=3333
# AGENT_TOKEN_BUDGET=400000     # per-agent health bar size
# WORKROOM_DEMO=1               # fake jobs + random chatter

# --- Telegram remote control (send goals from your phone, get a screenshot back) ---
# 1. Talk to @BotFather on Telegram, create a bot, paste its token below.
# 2. Start the workroom, message your bot once: it replies with your chat id.
# 3. Put that id into TELEGRAM_ALLOWED_CHAT_IDS (comma separated) and restart.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=
# BROWSER_BIN=   # path to Chrome/Edge if it is not found automatically

# --- Phone sharing (finished projects only; the control UI and API stay local) ---
# LAN_SHARE=0          # keep everything on this computer
# PUBLIC_HOST=         # override the detected Wi-Fi address (e.g. a Tailscale IP)

# --- Fallbacks when a model is out of tokens ---
# RUN_BACKENDS=claude,codex,gemini,local   # order the Build button tries models
# BACKEND_COOLDOWN_MIN=30            # how long a model that ran dry is skipped
# LLM_FALLBACKS=claude,gemini,openai # in-room agents: who answers when their own provider is out
# PROVIDER_COOLDOWN_MIN=10

# --- Local models (Ollama / LM Studio are detected automatically) ---
# LLM_PRIMARY=local        # in-room agents use the free local model first
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3:8b # chat answers
# LOCAL_RUN_MODEL=qwen3:8b # builds (needs a model that can use tools)
# LOCAL_LLM_KIND=ollama    # only needed for a custom port
# LOCAL_LLM=0              # turn local models off

# --- Orchestrated team (strong planner, cheaper workers) ---
# CLAUDE_PLAN_MODEL=opus     # Alice
# CLAUDE_RUN_MODEL=sonnet    # Bob (also used for solo builds)
# CLAUDE_CHECK_MODEL=haiku   # Charlie, Diana, Echo
# ORCHESTRATE=0              # one model for every step

# --- Video memory (VRAM) ---
# GPU_VRAM_GB=12    # only for cards nvidia-smi cannot see (AMD, Intel, Apple); sizes in the Models tab are compared with this
