# Copy to .env and fill in what you need. Everything is optional.

# --- In-room agents answer with these providers (otherwise they use free local replies) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Model overrides (optional) ---
# CLAUDE_MODEL=
# CLAUDE_ECO_MODEL=
# OPENAI_MODEL=
# OPENAI_ECO_MODEL=
# GEMINI_MODEL=
# GEMINI_ECO_MODEL=

# --- Goal runner (Build button, uses the local Claude Code CLI) ---
# CLAUDE_RUN_MODEL=sonnet      # use "haiku" for cheaper runs
# CLAUDE_RUN_MAX_TURNS=30

# --- Misc ---
# PORT=3333
# AGENT_TOKEN_BUDGET=400000     # per-agent health bar size
# WORKROOM_DEMO=1               # fake jobs + random chatter

# --- Telegram remote control (send goals from your phone, get a screenshot back) ---
# 1. Talk to @BotFather on Telegram, create a bot, paste its token below.
# 2. Start the workroom, message your bot once: it replies with your chat id.
# 3. Put that id into TELEGRAM_ALLOWED_CHAT_IDS (comma separated) and restart.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=
# BROWSER_BIN=   # path to Chrome/Edge if it is not found automatically

# --- Phone sharing (finished projects only; the control UI and API stay local) ---
# LAN_SHARE=0          # keep everything on this computer
# PUBLIC_HOST=         # override the detected Wi-Fi address (e.g. a Tailscale IP)
